# Application Settings
APP_NAME=Specta AI Platform
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development

# Server Settings
HOST=0.0.0.0
PORT=8000

# Database Settings
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/specta_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Sync Database URL for Alembic
SYNC_DATABASE_URL=postgresql://postgres:password@localhost:5432/specta_db

# CORS Settings
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Logging
LOG_LEVEL=INFO

# Optional: Redis
REDIS_URL=redis://localhost:6379/0

# Optional: LLM API Keys
MINIMAX_API_KEY=your_minimax_api_key
GLM5_API_KEY=your_glm5_api_key
DEEPSEEK_API_KEY=your_deepseek_api_key
DASHSCOPE_API_KEY=your_dashscope_api_key

# LLM Provider: "glm5", "minimax", or "deepseek"
LLM_PROVIDER=glm5

# DeepSeek model routing
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_NAME=deepseek-v4-pro
DEEPSEEK_FLASH_MODEL_NAME=deepseek-v4-flash
DEEPSEEK_PRO_MODEL_NAME=deepseek-v4-pro
DEEPSEEK_THINKING_ENABLED=false
ORCHESTRATOR_LLM_PROVIDER=deepseek
ORCHESTRATOR_MODEL_NAME=deepseek-v4-pro
ORCHESTRATOR_THINKING_ENABLED=true
LONG_TEXT_LLM_PROVIDER=deepseek
LONG_TEXT_MODEL_NAME=deepseek-v4-pro
LONG_TEXT_THINKING_ENABLED=true
A1_LLM_PROVIDER=glm5
A1_MODEL_NAME=glm-5
A1_THINKING_ENABLED=true
A3_LLM_PROVIDER=deepseek
A3_MODEL_NAME=deepseek-v4-pro
A3_THINKING_ENABLED=false
FAST_STRUCTURED_THINKING_ENABLED=false
URL_INTELLIGENCE_LLM_PROVIDER=deepseek
URL_INTELLIGENCE_MODEL_NAME=deepseek-v4-flash
