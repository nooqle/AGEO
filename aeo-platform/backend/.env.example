# Application Settings
APP_NAME=Miitus AEO Platform
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development

# Server Settings
HOST=0.0.0.0
PORT=8000

# Database Settings
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/miitus_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Sync Database URL for Alembic
SYNC_DATABASE_URL=postgresql://postgres:password@localhost:5432/miitus_db

# CORS Settings
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Logging
LOG_LEVEL=INFO

# Optional: Redis
REDIS_URL=redis://localhost:6379/0

# Optional: LLM API Keys
MINIMAX_API_KEY=your_minimax_api_key
GLM5_API_KEY=your_glm5_api_key
DASHSCOPE_API_KEY=your_dashscope_api_key

# LLM Provider: "glm5" or "minimax"
LLM_PROVIDER=glm5
