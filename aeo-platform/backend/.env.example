# Application Settings
APP_NAME=Specta AI Platform
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development

# Server Settings
HOST=0.0.0.0
PORT=8000

# Database Settings
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/specta_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Sync Database URL for Alembic
SYNC_DATABASE_URL=postgresql://postgres:password@localhost:5432/specta_db

# CORS Settings
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Logging
LOG_LEVEL=INFO

# Optional: Redis
REDIS_URL=redis://localhost:6379/0

# Optional: LLM API Keys
MINIMAX_API_KEY=your_minimax_api_key
GLM5_API_KEY=your_glm5_api_key
DEEPSEEK_API_KEY=your_deepseek_api_key
DASHSCOPE_API_KEY=your_dashscope_api_key

# Global fallback LLM Provider: "glm5", "minimax", or "deepseek"
LLM_PROVIDER=deepseek

# Canonical Specta model profiles
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_NAME=deepseek-flash
DEEPSEEK_FLASH_MODEL_NAME=deepseek-flash
DEEPSEEK_PRO_MODEL_NAME=deepseek-flash
DEEPSEEK_THINKING_ENABLED=false
TEXT_REASONING_LLM_PROVIDER=deepseek
TEXT_REASONING_MODEL_NAME=deepseek-flash
TEXT_REASONING_THINKING_ENABLED=true
TEXT_LIGHT_LLM_PROVIDER=deepseek
TEXT_LIGHT_MODEL_NAME=deepseek-flash
TEXT_LIGHT_THINKING_ENABLED=false
MULTIMODAL_LLM_PROVIDER=deepseek
MULTIMODAL_MODEL_NAME=deepseek-flash
MULTIMODAL_THINKING_ENABLED=true
