# Specta AI - Local Development Environment Configuration
# Copy this file to .env.local and fill in your actual values

# ============================================
# Database Configuration
# ============================================

# Option 1: SQLite (Simple, no setup required)
DATABASE_URL=sqlite+aiosqlite:///./specta_dev.db

# Option 2: PostgreSQL (Recommended for production-like environment)
# DATABASE_URL=postgresql+asyncpg://localhost/specta_dev
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/specta_dev

# ============================================
# Redis Configuration (Optional)
# ============================================

# Redis is optional. If not configured, the system will use in-memory cache.
# REDIS_URL=redis://localhost:6379/0

# ============================================
# LLM API Keys (Required for fetch functionality)
# ============================================

# MiniMax API Key (for Doubao platform)
# Get from: https://platform.minimaxi.com/
MINIMAX_API_KEY=your_minimax_api_key_here

# GLM5 (智谱AI) API Key
# Get from: https://open.bigmodel.cn/
GLM5_API_KEY=your_glm5_api_key_here

# DeepSeek API Key (for text reasoning and text light model profiles)
# Global fallback LLM Provider: "glm5", "minimax", or "deepseek"
LLM_PROVIDER=deepseek

# Canonical Specta model profiles
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_NAME=deepseek-flash
DEEPSEEK_FLASH_MODEL_NAME=deepseek-flash
DEEPSEEK_PRO_MODEL_NAME=deepseek-flash
DEEPSEEK_THINKING_ENABLED=false
TEXT_REASONING_LLM_PROVIDER=deepseek
TEXT_REASONING_MODEL_NAME=deepseek-flash
TEXT_REASONING_THINKING_ENABLED=true
TEXT_LIGHT_LLM_PROVIDER=deepseek
TEXT_LIGHT_MODEL_NAME=deepseek-flash
TEXT_LIGHT_THINKING_ENABLED=false
MULTIMODAL_LLM_PROVIDER=deepseek
MULTIMODAL_MODEL_NAME=deepseek-flash
MULTIMODAL_THINKING_ENABLED=true
# A dedicated browser key is used only when its provider matches MULTIMODAL_LLM_PROVIDER.
# Legacy dedicated keys default to glm5; set deepseek only for a DeepSeek-issued key.
# Otherwise the selected provider's normal API key is used.
BROWSER_AGENT_LLM_API_KEY_PROVIDER=glm5
# BROWSER_AGENT_LLM_API_KEY=

# Optional: model pricing config for token cost estimation
# Unit: RMB per 1,000,000 tokens
# GLM-5 / GLM-5-Turbo official pricing uses context-length tiers.
# Example values below are placeholders. Use your actual public price or contract price.
# GLM5_LONG_CONTEXT_THRESHOLD_TOKENS=32000
# GLM5_PRICE_INPUT_PER_MTOKENS=
# GLM5_PRICE_OUTPUT_PER_MTOKENS=
# GLM5_PRICE_LONG_INPUT_PER_MTOKENS=
# GLM5_PRICE_LONG_OUTPUT_PER_MTOKENS=
# GLM5_TURBO_PRICE_INPUT_PER_MTOKENS=
# GLM5_TURBO_PRICE_OUTPUT_PER_MTOKENS=
# GLM5_TURBO_PRICE_LONG_INPUT_PER_MTOKENS=
# GLM5_TURBO_PRICE_LONG_OUTPUT_PER_MTOKENS=
# MINIMAX_PRICE_INPUT_PER_MTOKENS=
# MINIMAX_PRICE_OUTPUT_PER_MTOKENS=

# LLM Provider: "glm5", "minimax", or "deepseek"
LLM_PROVIDER=deepseek

# Doubao API Key (for Doubao platform)
# Get from: https://www.volcengine.com/product/doubao
DOUBAO_API_KEY=your_doubao_api_key_here
# Fast A4 fetch uses this model when set. Use DOUBAO_MODEL as fallback.
DOUBAO_FAST_MODEL=doubao-seed-2-0-mini-260215
# Use Doubao App assistant API for fast A4 fetch when available.
DOUBAO_FAST_USE_APP_API=true
DOUBAO_APP_FEATURE=ai_search
DOUBAO_APP_API_FALLBACK_TO_WEB_SEARCH=true
# Per-question API pacing for fast A4 fetch.
A4_DOUBAO_API_DELAY_SECONDS=3.0

# Hunyuan API Key (for Hunyuan platform)
# Get from: https://cloud.tencent.com/product/hunyuan
HUNYUAN_API_KEY=your_hunyuan_api_key_here
# Optional fast-mode override. Leave empty to preserve search/citation behavior.
HUNYUAN_FAST_MODEL=
A4_HUNYUAN_API_DELAY_SECONDS=1.0
A4_KIMI_API_DELAY_SECONDS=1.0

# Kimi/Moonshot API Key (for Kimi platform)
# Get from: https://platform.kimi.com/
MOONSHOT_API_KEY=your_moonshot_api_key_here
MOONSHOT_MODEL=kimi-k2.6
MOONSHOT_FAST_MODEL=kimi-k2.6

# ============================================
# Browser Agent Configuration
# ============================================

# Playwright browser path (optional)
# PLAYWRIGHT_BROWSERS_PATH=0

# ============================================
# Development Settings
# ============================================

# Debug mode
DEBUG=true

# Log level
LOG_LEVEL=INFO

# CORS origins (for local development)
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# ============================================
# Auth & Verification
# ============================================

JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
VERIFICATION_CODE_EXPIRE_MINUTES=10
VERIFICATION_SEND_COOLDOWN_SECONDS=60
VERIFICATION_MAX_ATTEMPTS=5
VERIFICATION_EMAIL_PROVIDER=console
VERIFICATION_SMS_PROVIDER=console
VERIFICATION_EMAIL_FROM_ADDRESS=
VERIFICATION_EMAIL_FROM_NAME=Specta AI
VERIFICATION_EMAIL_SUBJECT_PREFIX=【Specta AI】
VERIFICATION_SMTP_HOST=
VERIFICATION_SMTP_PORT=587
# Optional. Defaults to VERIFICATION_EMAIL_FROM_ADDRESS when empty.
VERIFICATION_SMTP_USERNAME=
VERIFICATION_SMTP_PASSWORD=
VERIFICATION_SMTP_USE_TLS=true
VERIFICATION_SMTP_USE_SSL=false
TENCENT_SES_SECRET_ID=
TENCENT_SES_SECRET_KEY=
TENCENT_SES_REGION=ap-guangzhou
TENCENT_SES_FROM_EMAIL_ADDRESS=
TENCENT_SES_REPLY_TO_ADDRESS=
TENCENT_SES_TEMPLATE_ID=
TENCENT_SES_TEMPLATE_VARIABLES=code

# Development mode features (skip authentication, use default test user)
# WARNING: Only enable in development! Never in production!
DEV_MODE_ENABLED=true
DEV_TOKEN=dev-token
DEV_USER_EMAIL=dev@test.com
DEV_USER_NAME=Development User

# ============================================
# Optional: External Services
# ============================================

# Sentry DSN (for error tracking)
# SENTRY_DSN=

# ============================================
# Notes:
# ============================================
# 1. Copy this file to .env.local
# 2. Fill in your actual API keys
# 3. Choose your database (SQLite for simple dev, PostgreSQL for production-like)
# 4. Redis is optional - system works without it
# 5. Never commit .env.local to version control!
