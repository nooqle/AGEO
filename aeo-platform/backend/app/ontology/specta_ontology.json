{
  "version": "2026-05-16.1",
  "domain": "AI brand intelligence",
  "purpose": "Define the first durable business model for Specta so agents, reports, evidence, monitoring, and user decisions can work over the same brand intelligence world.",
  "principles": [
    "Model the brand intelligence reality, not workflow implementation details.",
    "Keep AgentState as runtime memory and make durable brand facts explicit objects over time.",
    "Make evidence traceable from report conclusions back to questions, platform answers, and citations.",
    "Expose user and agent changes as controlled actions with audit records.",
    "Let the brand object become the long-lived center of the product experience."
  ],
